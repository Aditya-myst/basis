{
  "name": "basis-agent-skill",
  "version": "0.2.0",
  "private": true,
  "description": "npm development and installation commands for the Basis agent skill",
  "scripts": {
    "validate": "python scripts/validate-package.py && python scripts/validate-report.py examples/report.json",
    "test": "npm run validate && python -m unittest discover -s tests -v",
    "skills:list": "npx --yes skills@1.5.20 add . --list",
    "install:codex": "npx --yes skills@1.5.20 add . --global --agent codex",
    "install:claude": "npx --yes skills@1.5.20 add . --global --agent claude-code",
    "install:all": "npx --yes skills@1.5.20 add . --global --agent \"*\""
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT"
}
